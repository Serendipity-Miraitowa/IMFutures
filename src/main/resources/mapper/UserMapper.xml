<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTO Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.imfutures.mapper.UserMapper">

    <!--修改用户信息-->
    <update id="updateUser" parameterType="org.example.imfutures.dto.UpdateUser">
        update users
        <set>
            <if test="password != null and password.length>0">
                password = #{password},
            </if>
            <if test="salt != null and salt.length>0">
                salt = #{salt},
            </if>
            <if test="userName != null and userName.length>0">
                user_name = #{userName},
            </if>
            <if test="phone != null and phone.length>0">
                phone = #{phone},
            </if>
            <if test="email != null and email.length>0">
                email = #{email},
            </if>
            <if test="avatar != null and avatar.length>0">
                avatar = #{avatar},
            </if>
            <if test="sex != null and sex.length>0">
                sex = #{sex},
            </if>
            <if test="birthday != null">
                birthday = #{birthday},
            </if>
        </set>
        where uid = #{id}
    </update>

    <!--查询用户信息-->
    <select id="select" parameterType="java.lang.Integer" resultType="Users">
        select * from users where uid = #{id};
    </select>
    
    <!--添加实名认证-->
    <insert id="addCard" parameterType="Card">
        <selectKey resultType="java.lang.Integer" order="AFTER" keyProperty="id">
            select LAST_INSERT_ID()
        </selectKey>
        insert into card
        <trim prefix="(" suffix=")" suffixOverrides=",">
            name,
            number,
            startDay,
            endDay,
            sex,
            type,
            nationality,
            birthday
        </trim>
        <trim prefix="values(" suffix=")" suffixOverrides=",">
            #{name},
            #{number},
            #{startDay},
            #{endDay},
            #{sex},
            #{type},
            #{nationality},
            #{birthday}
        </trim>
    </insert>

    <!--修改user表实名认证信息-->
    <update id="update" parameterType="map">
        update users set card_id = #{cardId} where uid = #{id}
    </update>

    <!--更新实名认证-->
    <update id="updateCard" parameterType="org.example.imfutures.dto.Cards">
        update card
        <set>
            <if test="name != null and name.length>0">
                name = #{name}
            </if>
            <if test="number != null">
                number = #{number}
            </if>
            <if test="startDay != null">
                startDay = #{startDay}
            </if>
            <if test="endDay != null">
                endDay = #{endDay}
            </if>
            <if test="sex != null and sex.length>0">
                sex = #{sex}
            </if>
            <if test="type != null and type.length>0">
                type = #{type}
            </if>
            <if test="nationality != null and nationality.length>0">
                nationality = #{nationality}
            </if>
            <if test="birthday != null">
                birthday = #{birthday}
            </if>
        </set>
        where id = #{id}
    </update>

    <!--修改支付密码-->
    <update id="updatePayPassword" parameterType="org.example.imfutures.pojo.Users">
        update users set pay_password = #{payPassword} where uid = #{uid}
    </update>

    <!--查询免密支付列表-->
    <select id="selectNoPay" parameterType="java.lang.Integer" resultType="freePay">
        select * from free_pay where user_id = #{uid};
    </select>

    <!--查询免密支付详情-->
    <select id="selectNoPayDetail" parameterType="java.lang.Integer" resultType="freePay">
        select * from free_pay where id = #{id}
    </select>



</mapper>