<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTO Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.imfutures.mapper.CommentMapper">
    <!--添加评论-->
    <insert id="insert" parameterType="org.example.imfutures.dto.CommentsInsert" useGeneratedKeys="true" keyColumn="id" keyProperty="id">
        insert into comments (content, date, score, user_id, charging_station_id) values (#{content}, #{date}, #{score}, #{userId}, #{chargingStationId})
    </insert>

    <!--更新订单评论状态-->
    <update id="update" parameterType="org.example.imfutures.dto.CommentsInsert">
        update `order` set comment_id = #{id} where id = #{orderId}
    </update>

    <!--查询用户评论-->
    <select id="selectByUserId" parameterType="java.lang.Integer" resultType="comments">
        select * from comments where user_id = #{id}
    </select>

    <!--计算充电站平均分-->
    <select id="selectShip" parameterType="java.lang.Integer" resultType="comments">
        select * from comments where charging_station_id = #{id}
    </select>
    <update id="updateScore" parameterType="java.lang.Double">
        update charging_stations set score = #{score} where id = #{id}
    </update>

</mapper>